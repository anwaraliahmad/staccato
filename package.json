{
  "name": "staccato",
  "version": "2.0.0",
  "description": "A WebGL music visualizer: FFT data from the Web Audio API, hand-written GLSL, wireframes.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anwaraliahmad/staccato.git"
  },
  "author": "Anwar Ali-Ahmad <@anwaraliahmad>",
  "license": "MIT",
  "homepage": "https://github.com/anwaraliahmad/staccato#readme",
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "typescript": "~5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
